--- /dev/null
+++ b/setup/packages/admin/src/Helper/ServerHelper.php
@@ -0,0 +1,37 @@
+<?php
+namespace TemPlaza\Component\TZ_Portfolio\Administrator\Helper;
+
+defined('_JEXEC') or die;
+
+use Joomla\CMS\Http\HttpFactory;
+use Joomla\CMS\Language\Text;
+
+/** Requests to the vendor must preserve TLS verification and never expose tokens in errors. */
+class ServerHelper
+{
+    public static function request($url, $method = 'get', $data = array())
+    {
+        $host = parse_url($url, PHP_URL_HOST);
+        try {
+            $client = HttpFactory::getHttp(array('timeout' => 30));
+            $response = $method === 'post' ? $client->post($url, $data) : $client->get($url);
+        } catch (\Throwable $error) {
+            // Transport exceptions can contain the complete URL, including a token.
+            throw new \RuntimeException(Text::sprintf('COM_TZ_PORTFOLIO_SERVER_CONNECTION_ERROR', $host));
+        }
+        $status = $response->getStatusCode();
+        if ($status !== 200) {
+            throw new \RuntimeException(Text::sprintf('COM_TZ_PORTFOLIO_SERVER_HTTP_ERROR', $host, $status));
+        }
+        return $response;
+    }
+
+    public static function decodeJson($response)
+    {
+        $data = json_decode((string) $response->getBody());
+        if (!is_object($data) || !isset($data->state)) {
+            throw new \RuntimeException(Text::_('COM_TZ_PORTFOLIO_SERVER_INVALID_RESPONSE'));
+        }
+        return $data;
+    }
+}
